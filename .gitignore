# Secrets and Scratch
tmp/*
.env
.env.*

# APM dependencies
apm_modules/
.mcp.json

# APM pack scratch bundles
build/

# Python bytecode.
__pycache__/
*.py[cod]

# VSCode
.vscode/*

# Github: APM deploys Copilot primitives here (.github/instructions/ et al),
# so the directory is ignored by default -- workflows are authored, not deployed.
.github/*
!.github/workflows/

# Agents
.agents/*

# Claude: Keep settings for global configs and apm-hooks as "lockfile-ish"
.claude/*
!.claude/settings.json
!.claude/apm-hooks.json

# Codex: Keep apm-hooks as "lockfile-ish"
.codex/*
!.codex/apm-hooks.json
