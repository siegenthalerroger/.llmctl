# Secrets and Scratch
tmp/*
.env
.env.*

# APM dependencies
apm_modules/
.mcp.json

# APM install output inside a package (a local `apm install` there): the
# committed apm.lock.yaml is the only install artefact a package keeps.
packages/*/.claude/
packages/*/.agents/
packages/*/.codex/
packages/*/.github/
packages/*/.gitignore

# APM pack scratch bundles
build/

# The tooling's own environment and build output (uv run / uv build).
.venv/
dist/

# Python bytecode.
__pycache__/
*.py[cod]

# VSCode
.vscode/*

# Github: APM deploys Copilot primitives here, so the directory is ignored by
# default -- workflows and the composite actions they share are authored.
.github/*
!.github/workflows/
!.github/actions/

# Agents
.agents/*

# Claude: Keep settings for global configs and apm-hooks as "lockfile-ish"
.claude/*
!.claude/settings.json
!.claude/apm-hooks.json

# Codex: Keep apm-hooks as "lockfile-ish"
.codex/*
!.codex/apm-hooks.json
