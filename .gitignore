# Secrets and Scratch
tmp/*
.env
.env.*

# APM dependencies
apm_modules/
.mcp.json

# APM install output inside a package (a local `apm install` there): the
# committed apm.lock.yaml is the only install artefact a package keeps.
packages/*/.claude/
packages/*/.agents/
packages/*/.codex/
packages/*/.github/
packages/*/.gitignore

# APM pack scratch bundles
build/

# The tooling's own environment and build output (uv run / uv build).
.venv/
dist/

# Python bytecode.
__pycache__/
*.py[cod]

# VSCode
.vscode/*

# Github: APM deploys Copilot primitives here, so the directory is ignored by
# default -- workflows and the composite actions they share are authored.
.github/*
!.github/workflows/
!.github/actions/

# Harness deploy output. Every file under these is written by `apm install`
# from the sources in .apm/ and packages/, so none of it is authored and none
# of it is committed -- a clone runs `apm install` and gets its own. That is
# also why this repo's own PostToolUse hook only fires after that first
# install: the wiring it lives in does not arrive with the checkout.
.agents/*
.claude/*
.codex/*
