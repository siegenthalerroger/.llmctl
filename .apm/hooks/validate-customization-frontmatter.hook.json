{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from git+https://github.com/siegenthalerroger/.llmctl@main llmctl-check-frontmatter --repo \"${CLAUDE_PROJECT_DIR}\" --hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
