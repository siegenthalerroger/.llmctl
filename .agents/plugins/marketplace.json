{
  "name": "llmctl",
  "interface": {
    "displayName": "llmctl"
  },
  "plugins": [
    {
      "name": "llmctl-core",
      "source": {
        "source": "local",
        "path": "./packages/core"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Development"
    },
    {
      "name": "llmctl-meta",
      "source": {
        "source": "local",
        "path": "./packages/meta"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Development"
    },
    {
      "name": "llmctl-ops",
      "source": {
        "source": "local",
        "path": "./packages/ops"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "DevOps"
    },
    {
      "name": "llmctl-product",
      "source": {
        "source": "local",
        "path": "./packages/product"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Product"
    }
  ]
}
